# VCReady — environment variables template.
# Copy this file to ".env" and fill in values. Never commit ".env".

# -----------------------------
# OpenAI-compatible relay (primary path used by app.py)
# Works for any OpenAI-compatible endpoint, including relay/proxy gateways
# that expose Claude or other models behind an OpenAI-shaped API.
# -----------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# -----------------------------
# Reserved for a native Anthropic endpoint (not wired into app.py yet).
# Fill these in later if you decide to call Claude directly via the
# Anthropic SDK instead of through the OpenAI-compatible relay.
# -----------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
